{
  "name": "@clipper/shared-ui",
  "version": "1.0.0",
  "description": "Shared React components for Clipper frontends",
  "main": "src/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch"
  },
  "peerDependencies": {
    "@clipper/shared-types": "^1.0.0",
    "@heroui/react": "^3.0.0",
    "@iconify/react": "^5.0.0 || ^6.0.0",
    "framer-motion": "^11.0.0 || ^12.0.0",
    "jotai": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@clipper/shared-types": "file:../shared-types",
    "@heroui/react": "^3.0.1",
    "@iconify/react": "^5.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "framer-motion": "^12.0.0",
    "jotai": "^2.19.1",
    "typescript": "^5.3.3"
  }
}

# Multi-stage Dockerfile for GPU Worker
# This worker polls SQS for GPU face swap jobs, connects to RunPod GPUs via HTTP/WebSocket

# Stage 1: Build stage
FROM node:22-slim AS builder

# Install pnpm
RUN npm install -g pnpm

WORKDIR /app

# Copy package files for all workspaces
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY backend/package.json ./backend/
COPY packages/shared-db/package.json ./packages/shared-db/

# Install ALL dependencies (including dev dependencies for build)
RUN pnpm install --frozen-lockfile

# Copy source code
COPY backend ./backend
COPY packages/shared-db ./packages/shared-db

# Build shared-db first
WORKDIR /app/packages/shared-db
RUN pnpm run build

# Build backend (which includes the gpu-worker)
WORKDIR /app/backend
RUN pnpm run build

# Stage 2: Production stage
FROM node:22-slim

# Install system dependencies for ffmpeg (video cutting/merging)
RUN apt-get update && apt-get install -y \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install pnpm
RUN npm install -g pnpm

WORKDIR /app

# Copy entire workspace from builder (this preserves pnpm's symlink structure)
COPY --from=builder /app ./

# Create output directory for video processing
RUN mkdir -p /app/backend/output && chmod 777 /app/backend/output

# Set environment variables
ENV NODE_ENV=production

# Run the GPU worker from the monorepo root
CMD ["node", "backend/dist/gpu-worker/index.js"]

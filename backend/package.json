{
  "name": "clipper-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/server.ts",
    "dev:worker": "nodemon --watch src --exec ts-node src/worker/index.ts",
    "build": "tsc && cp -r src/fonts dist/ && cp -r src/templates dist/ && cp -r src/config dist/",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker/index.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "db:generate": "pnpm --filter @clipper/shared-db db:generate",
    "db:migrate": "pnpm --filter @clipper/shared-db db:migrate",
    "db:studio": "pnpm --filter @clipper/shared-db db:studio",
    "stripe:create-plans": "ts-node src/config/stripe.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --exclude 'test/integration/**'",
    "test:integration": "vitest run test/integration"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-ecs": "^3.957.0",
    "@aws-sdk/client-lambda": "^3.964.0",
    "@aws-sdk/client-s3": "^3.948.0",
    "@aws-sdk/client-sqs": "^3.948.0",
    "@aws-sdk/lib-storage": "^3.948.0",
    "@aws-sdk/s3-request-presigner": "^3.709.0",
    "@clipper/shared-db": "workspace:*",
    "@deepgram/sdk": "^4.11.2",
    "@elevenlabs/elevenlabs-js": "^2.30.0",
    "@fal-ai/client": "^1.8.3",
    "@google/genai": "^1.34.0",
    "@sentry/node": "^10.32.1",
    "@sentry/profiling-node": "^10.32.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.87.1",
    "apify-client": "^2.22.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.44.7",
    "express-rate-limit": "^8.2.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "isomorphic-dompurify": "^2.35.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "nanoid": "^5.1.6",
    "openai": "^6.9.1",
    "pg": "^8.16.3",
    "puppeteer": "^24.33.0",
    "resend": "^6.6.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "stripe": "^20.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.18.3",
    "zod": "^4.1.13",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.2",
    "@types/pg": "^8.15.6",
    "@types/socket.io": "^3.0.2",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9.39.1",
    "express": "^5.1.0",
    "install": "^0.13.0",
    "nodemon": "^3.1.11",
    "npm": "^11.6.4",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}

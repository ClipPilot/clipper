{
  "name": "clipper-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/server.ts",
    "dev:worker": "nodemon --watch src --exec ts-node src/worker/index.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker/index.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "db:generate": "pnpm --filter @clipper/shared-db db:generate",
    "db:migrate": "pnpm --filter @clipper/shared-db db:migrate",
    "db:studio": "pnpm --filter @clipper/shared-db db:studio",
    "db:push": "pnpm --filter @clipper/shared-db db:push"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.948.0",
    "@aws-sdk/client-sqs": "^3.948.0",
    "@aws-sdk/lib-storage": "^3.948.0",
    "@aws-sdk/s3-request-presigner": "^3.709.0",
    "@clipper/shared-db": "workspace:*",
    "@deepgram/sdk": "^4.11.2",
    "@supabase/supabase-js": "^2.87.1",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.44.7",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^2.0.2",
    "openai": "^6.9.1",
    "pg": "^8.16.3",
    "puppeteer": "^24.33.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.2",
    "@types/pg": "^8.15.6",
    "@types/socket.io": "^3.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9.39.1",
    "express": "^5.1.0",
    "install": "^0.13.0",
    "nodemon": "^3.1.11",
    "npm": "^11.6.4",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}

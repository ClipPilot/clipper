{
  "compilerOptions": {
    "target": "ES2021",
    "module": "node16",
    "lib": ["ES2021"],
    "moduleResolution": "node16",
    
    "outDir": "dist",
    "rootDir": "src",

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types", "../node_modules/@types", "./src/types"],
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    "types": ["node", "express"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "src/archive", "src/**/__tests__", "src/**/*.test.ts", "src/**/*.spec.ts"]
}

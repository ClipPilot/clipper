# ===========================================
# Clipper Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Server Configuration
PORT=3001
NODE_ENV=development

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# Supabase Auth
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJxxxxx

# AI Services
OPENAI_API_KEY=sk-xxxxx
DEEPGRAM_API_KEY=xxxxx

# AWS Configuration
AWS_REGION=us-west-2
AWS_S3_BUCKET=clipster-videos-prod
AWS_ACCESS_KEY_ID=AKIA...      # Only needed for local dev
AWS_SECRET_ACCESS_KEY=xxxxx    # Only needed for local dev
SQS_QUEUE_URL=https://sqs.us-west-2.amazonaws.com/xxx/clipster-queue

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_xxxxx           # Use sk_live_xxx for production
STRIPE_WEBHOOK_SECRET=whsec_xxxxx         # From Stripe Dashboard > Webhooks

# Internal API (Worker to Server communication)
INTERNAL_API_KEY=xxxxx
API_INTERNAL_URL=http://localhost:3001

# Google Drive (Mass Posting)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_PARENT_FOLDER_ID=your_folder_id_from_drive_url

# Ad Posting Webhook (shared secret with botfarm)
AD_POSTING_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32

# GPU Worker Configuration (for running gpu-worker locally)
# Use the local-dev queue to avoid stealing messages from deployed staging/prod workers
GPU_SQS_QUEUE_URL=https://sqs.us-west-2.amazonaws.com/xxx/clipster-gpu-processing-local-dev
# GPU_ID=gpu-2  # Optional: lock to specific GPU from gpus.config.json
